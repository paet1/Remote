<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Semi-transparent dark overlay -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#990D1117"/>
        </shape>
    </item>
    <!-- Radial glow in center for SOC ring area -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="280dp"
                android:centerX="0.5"
                android:centerY="0.45"
                android:startColor="#33039BE5"
                android:endColor="#00000000"/>
        </shape>
    </item>
    <!-- Bottom fade to solid background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#000D1117"
                android:endColor="#CC0D1117"/>
        </shape>
    </item>
</layer-list>
